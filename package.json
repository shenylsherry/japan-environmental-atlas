{
  "name": "japan-environmental-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy ./node_modules/vite/bin/vite.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:terrain": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "devDependencies": {
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=24.5"
  },
  "description": "Japan-wide environmental atlas for layered terrain, vegetation, geology and soil exploration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenylsherry/japan-environmental-atlas.git"
  }
}
